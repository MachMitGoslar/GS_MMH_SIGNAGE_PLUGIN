{
  "name": "gs-mmh-signage",
  "version": "1.0.0",
  "description": "Digital signage plugin for Kirby CMS",
  "scripts": {
    "build": "echo \"Building signage plugin...\"; kirbyup src/index.js",
    "format": "prettier --write \"**/*.{js,vue}\" && ddev composer run format",
    "format:check": "prettier --check \"**/*.{js,vue}\"",
    "lint": "npm run format:check && ddev composer run lint",
    "lint:frontend": "npm run format:check",
    "pre-push": "npm run lint && npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "kirbyup": "^3.5.0",
    "prettier": "^3.9.10"
  }
}
